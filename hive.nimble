version     = "0.1.0"
author      = "daveey"
description = "Hive: four ant colonies foraging one meadow for the Softmax Coworld platform. Twenty-four ants a seat, two decaying pheromones, no messaging - coordination has to be stigmergic."
license     = "MIT"

srcDir = "src"

requires "nim >= 2.2.4"
requires "bitworld >= 0.1.0"
requires "mummy >= 0.4.7"
requires "curly >= 1.1.1"
requires "whisky"
